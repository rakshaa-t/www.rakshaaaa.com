# Environment Variables
# Copy this file to .env.local and fill in the values

# Required: OpenAI API Key for AI chat functionality
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Contact form endpoint
# CONTACT_FORM_ENDPOINT=https://your-form-endpoint.com

# Note: After adding/updating env vars in Vercel:
# 1. Set the variable for ALL environments (Production, Preview, Development)
# 2. Redeploy your application for changes to take effect
